# Opsional: isi untuk mengaktifkan /ai (chat dan analisis foto).
# Ambil API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Owner bot untuk /log, /ping, dan /kirim; pisahkan dengan koma.
# Bisa nomor internasional (628...) atau JID @lid.
# Tanpa owner, ketiga command tersebut tidak bisa dipakai. Admin grup tidak otomatis owner.
OWNER_NUMBERS=

# Tidak ada Google Sheets, pendaftaran, atau allowlist.
# Folder sesi login WhatsApp; default relatif ke folder project.
AUTH_DIR=auth_session

# Path executable kalau tidak ditemukan di PATH. Jangan tambahkan argumen di sini.
YT_DLP_PATH=
FFMPEG_PATH=ffmpeg
# Level log internal Baileys. Pakai debug untuk detail stack lengkap.
LOG_LEVEL=warn
# pretty untuk terminal; json untuk pemrosesan log otomatis.
LOG_FORMAT=pretty
