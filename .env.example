# ============================================================
# TEMPLATE .env — copy/rename file ini jadi ".env" lalu isi
# nilai di bawah ini. JANGAN pernah share file .env yang udah
# keisi ke siapapun atau upload ke tempat publik (GitHub dll),
# soalnya isinya kredensial rahasia.
# ============================================================

# ---- Gemini API Key ----
# Ambil dari: https://aistudio.google.com/apikey
# Klik "Create API Key", copy hasilnya ke sini.
GEMINI_API_KEY=isi_api_key_gemini_disini

# ---- Spreadsheet ID ----
# Buka Google Sheets kamu, lihat URL-nya:
# docs.google.com/spreadsheets/d/SPREADSHEET_ID_ADA_DISINI/edit
# Copy bagian ID-nya doang (di antara /d/ dan /edit), bukan URL lengkapnya.
SPREADSHEET_ID=isi_spreadsheet_id_disini

# ---- Path ke Service Account JSON ----
# File JSON yang kamu download dari Google Cloud (IAM & Admin > Service
# Accounts > Keys > Add Key > JSON). Rename jadi "service-account.json"
# dan taruh di folder yang sama kayak index.js. Biarin default di bawah
# ini kalau namanya emang persis "service-account.json".
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# ---- Siapa yang boleh pakai FITUR bot ----
# Isi JID (bukan nomor telepon biasa) orang yang boleh akses fitur
# (catat uang, todo, dll), pisahin pakai koma kalau lebih dari satu.
# Cara dapetin JID: chat /help ke bot, lihat di terminal muncul baris
# "[MASUK] <jid-nya-disini> -> /help", copy itu.
# KOSONGIN/HAPUS baris ini kalau mau SEMUA orang yang /daftarbot bisa
# langsung akses fitur tanpa perlu di-approve manual (direkomendasikan
# buat pemakaian personal/santai).
ALLOWED_NUMBERS=

# ---- Siapa admin/pemilik bot ----
# Isi JID KAMU sendiri di sini (cara dapetin JID sama kayak di atas).
# Yang ada di sini doang yang bisa pakai command admin: /listuser,
# /adminhapususer, /testreminder, /ping, /alert. Pisah koma kalau owner-nya
# lebih dari satu orang.
OWNER_NUMBERS=isi_jid_kamu_disini
